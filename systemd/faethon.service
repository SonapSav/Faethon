[Unit]
Description=Faethon voice assistant
Documentation=https://github.com/local/faethon
# Needs a working network before the first OpenRouter call, and the sound
# devices enumerated before opening the mic.
After=network-online.target sound.target
Wants=network-online.target
# Give up after five crashes in five minutes, and say so out loud (below).
# Not the earlier StartLimitIntervalSec=0: retrying forever meant the unit
# never reached a failed state, so nothing could ever announce that Faethon
# was broken -- it just looped silently, which is how this service spent its
# first half hour of existence.
#
# Nothing transient reaches here anyway. A lost network doesn't crash Faethon,
# it fails calls; an unplugged microphone raises CaptureError, which the run
# loop catches and retries in-process. Reaching five crashes means something is
# properly broken, and looping on it is no better than stopping.
#
# Both keys have to live in [Unit]. systemd ignores them under [Service], which
# it does quietly enough that the feature simply never happens.
StartLimitIntervalSec=300
StartLimitBurst=5

# Say so out loud when it does give up. Everything else Faethon announces goes
# through Faethon, which is no use when Faethon is what failed.
OnFailure=faethon-failed.service

[Service]
Type=simple
User=webmaster
Group=webmaster
# ALSA device access.
SupplementaryGroups=audio

WorkingDirectory=/home/webmaster/apps/faethon
# `uv run` re-syncs the venv from uv.lock if it drifted, so a `git pull`
# followed by a restart picks up dependency changes without extra steps.
ExecStart=/home/webmaster/.local/bin/uv run --project /home/webmaster/apps/faethon faethon

# The API key. pydantic-settings also reads this file directly, so this line is
# belt-and-braces; the leading "-" keeps the unit from failing if it's absent.
EnvironmentFile=-/home/webmaster/apps/faethon/.env

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=faethon

# Modest hardening. Faethon needs the network, the sound devices, and its own
# directory -- not much else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# openWakeWord caches its models inside the venv, and uv writes there too.
# uv's own cache lives outside the project and is hidden by ProtectHome, so it
# needs naming explicitly -- without it `uv run` dies with "Could not acquire
# lock ... Read-only file system" before Faethon gets a chance to start. Shared
# with the user's interactive cache on purpose: a private one would re-download
# every wheel on first boot.
ReadWritePaths=/home/webmaster/apps/faethon /home/webmaster/.cache/uv
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
